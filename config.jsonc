{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
    "source": "/home/stock/Downloads/ascii-art.txt",
    "color": {
      "1": "#63c9e1",
      "2": "#63c9e1"
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 7
    },
    "color": {
      "keys": "#b2c9e1",
      "title": "#bfc7d2"
    },
    "percent": {
      "color": {
        "green": "#b2c9e1",
        "yellow": "#b2c9e1",
        "red": "#b2c9e1"
      }
    }
  },
  "modules": [
    "title",
    {
      "type": "host",
      "key": "host",
      "format": "Lenovo Yoga 500"
    },
    {
      "type": "bootmgr",
      "key": "boot",
      "format": "limine"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminalfont",
      "key": "font",
      "format": "{name}"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{all}"
    },
    {
      "type": "memory",
      "key": "mem",
      "format": "{used} used"
    }
  ]
}
